# Copia esto a .env para desarrollar en local, con `docker compose up -d` corriendo.
# En el VPS, estas variables se ponen en la interfaz de Dokploy.

DATABASE_URL=postgresql://magic:magic@localhost:5463/magic

# Firma las cookies de sesión. En producción es obligatorio y si cambia se cierran
# todas las sesiones. Generar uno con: openssl rand -base64 32
# AUTH_SECRET=

# Opcional: la URL pública, para quitar un aviso de better-auth al arrancar.
# PUBLIC_URL=https://magic.midominio.com

# Cuotas de las ilustraciones, en bytes. Por defecto 10 MB por imagen y 200 MB
# por usuario.
# MAX_ART_BYTES=10485760
# MAX_ART_BYTES_PER_USER=209715200
