{
  "name": "@magic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "imports": {
    "#prisma": "./generated/prisma/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && node build.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run tests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@prisma/client": "^5.19.1",
    "better-auth": "1.6.25",
    "hono": "^4.6.3",
    "prisma": "^5.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@magic/shared": "workspace:*",
    "@types/node": "^22.5.4",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
