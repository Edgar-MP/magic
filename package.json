{
  "name": "magic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @magic/web dev",
    "dev:server": "pnpm --filter @magic/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @magic/api start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "pnpm --filter @magic/api test:integration",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @magic/api prisma:migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint packages",
    "assets": "tsx scripts/fetch-assets.ts",
    "cards:index": "tsx scripts/build-card-index.ts"
  },
  "devDependencies": {
    "@magic/renderer": "workspace:*",
    "@magic/shared": "workspace:*",
    "@types/node": "^22.5.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
